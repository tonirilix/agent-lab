# Agent Lab configuration
#
# Copy this file to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# `.env` is ignored by Git. Never commit it and never share it.
# Variables already set in your shell take precedence over this file.
# The server reads this file; the browser client never sees it.
# Do not use a `VITE_` prefix here: Vite exposes such variables to the browser.

# Required for real Agent Turns. Without it the UI opens in setup mode.
OPENAI_API_KEY=

# Optional. OpenAI model to use. Defaults to gpt-5.6-sol.
# OPENAI_MODEL=gpt-5.6-sol

# Optional. Workspace the Agent may inspect. `--workspace <path>` on the
# command line overrides this. Defaults to examples/task-list.
# AGENT_LAB_WORKSPACE=examples/task-list

# Optional. Port for the production server (`pnpm start`). Defaults to 8787.
# AGENT_LAB_PORT=8787

# Optional. Override the browser origin that Agent and Change Set requests
# must carry. Normally derived from the port; leave unset.
# AGENT_LAB_BROWSER_ORIGIN=http://127.0.0.1:8787
